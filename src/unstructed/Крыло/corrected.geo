да я новый использовала .geo-файл, вот он:
Что не так?!
// ============================================================
// Симметричная конфигурация для NACA 0012
// Левая граница - вход (inflow), правая - выход (outflow),
// верх/низ - стенка (симметрия)
// ============================================================

// ------------------- НАСТРОЙКИ РАЗМЕРОВ (меняйте здесь) -------------------
lc_foil = 0.01;        // размер ячеек на поверхности профиля
bl_layers = 12;        // количество приграничных слоёв
bl_h0 = 0.01;         // высота первого слоя
bl_ratio = 1.5;        // коэффициент роста слоёв (геометрическая прогрессия)
h_min = 0.014;         // минимальный размер ячейки у стенки (после слоёв)
h_max = 0.9;           // максимальный размер ячейки на удалении
R_dist = 5.0;          // расстояние, на котором размер достигает h_max
// ----------------------------------------------------------------------

t = 0.12;              // толщина профиля (NACA 0012)
n_pts = 20;           // количество точек на полупрофиле

// 1. Внешний прямоугольник
x_min = -3.0; x_max = 8.0; y_min = -2.0; y_max = 2.0;
Point(1) = {x_min, y_min, 0, 1.0};
Point(2) = {x_max, y_min, 0, 1.0};
Point(3) = {x_max, y_max, 0, 1.0};
Point(4) = {x_min, y_max, 0, 1.0};

// Линии прямоугольника
Line(1) = {1,2};   // нижняя граница
Line(2) = {2,3};   // правая граница (будет выход)
Line(3) = {3,4};   // верхняя граница
Line(4) = {4,1};   // левая граница (будет вход)

// 2. Профиль NACA 0012 (косинусное распределение)
Point(10) = {1.0, 0.0, 0, lc_foil};   // задняя кромка
Point(11) = {0.0, 0.0, 0, lc_foil};   // передняя кромка

// Верхняя поверхность (от задней кромки к передней)
upper_pts[] = {10};
For i In {1 : n_pts-1}
  xi = 0.5 * (1 - Cos(3.141592653589793 * i / n_pts));
  x = 1.0 - xi;
  y = 5*t * (0.2969*Sqrt(x) - 0.1260*x - 0.3516*x^2 + 0.2843*x^3 - 0.1015*x^4);
  Point(100+i) = {x, y, 0, lc_foil};
  upper_pts[] += 100+i;
EndFor
upper_pts[] += 11;

// Нижняя поверхность (от передней кромки к задней)
lower_pts[] = {11};
For i In {1 : n_pts-1}
  xi = 0.5 * (1 - Cos(3.141592653589793 * i / n_pts));
  x = xi;
  y = -5*t * (0.2969*Sqrt(x) - 0.1260*x - 0.3516*x^2 + 0.2843*x^3 - 0.1015*x^4);
  Point(200+i) = {x, y, 0, lc_foil};
  lower_pts[] += 200+i;
EndFor
lower_pts[] += 10;

Spline(20) = upper_pts[];
Spline(21) = lower_pts[];

// 3. Поверхность (область между внешней рамкой и профилем)
Line Loop(12) = {20,21};
Line Loop(1)  = {1,2,3,4};
Plane Surface(1) = {1,12};

// 4. ФИЗИЧЕСКИЕ ГРУППЫ – ИСПРАВЛЕННЫЙ СИММЕТРИЧНЫЙ ВАРИАНТ
Physical Curve("wall",    1) = {20,21, 1,3};  // профиль, низ, верх – стенка
Physical Curve("inflow",  2) = {4};            // левая граница – вход
Physical Curve("outflow", 3) = {2};            // правая граница – выход
Physical Surface("fluid", 10) = {1};

// 5. Пограничные слои
Field[3] = BoundaryLayer;
Field[3].LinesList = {20,21};
Field[3].hwall = bl_h0;
Field[3].ratio = bl_ratio;
Field[3].nbLayers = bl_layers;
BoundaryLayer Field = 3;

// 6. Фоновое поле размера
Field[1] = Distance;
Field[1].EdgesList = {20,21};

Field[2] = Threshold;
Field[2].IField = 1;
Field[2].LcMin = h_min;
Field[2].LcMax = h_max;
Field[2].DistMin = 0.0;
Field[2].DistMax = R_dist;

Background Field = 2;

// 7. Настройки генерации сетки
Mesh.Algorithm = 8;
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2;

// 8. Генерация сетки
Mesh 2;

Printf("==========================================");
Printf("Сетка построена (симметричная конфигурация).");
Printf("Физические группы: inflow(левая)=2, outflow(правая)=3, wall=1");
Printf("==========================================");